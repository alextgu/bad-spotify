# Every key here is OPTIONAL. With none of them set, the whole pipeline
# runs end-to-end on mock backends. That is deliberate: hour 0 of a
# hackathon should not be blocked on credentials.

GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Playback control still works on Spotify. audio-features does not.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional, post-session recap only
TWELVELABS_API_KEY=
